{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nnoovvaa4",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a7bd7ac3-4513-4254-b2d9-782e97b5eb30","database_name": "mahan" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "654b8be6e91849f79e82a8bb7d1b0234" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
